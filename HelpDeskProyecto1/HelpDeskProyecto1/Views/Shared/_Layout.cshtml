@{
    var autenticado = Session["UsuarioId"] != null;
    var rol = Session["Rol"] as string;
    var nombre = Session["NombreUsuario"] as string;
}

<!DOCTYPE html>

<html>
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewBag.Title - Help Desk
    </title>

    @Styles.Render("~/Content/css")

    @Scripts.Render("~/bundles/modernizr")

</head>

<body>

    <nav class="navbar navbar-expand-sm navbar-dark bg-dark">

        <div class="container">

            @if (!autenticado)
            {
                @Html.ActionLink(
                    "Help Desk",
                    "Login",
                    "Account",
                    null,
                    new { @class = "navbar-brand" }
                )
            }
            else if (rol == "Administrador")
            {
                @Html.ActionLink(
                    "Help Desk",
                    "Inicio",
                    "Admin",
                    null,
                    new { @class = "navbar-brand" }
                )
            }
            else
            {
                @Html.ActionLink(
                    "Help Desk",
                    "MisTickets",
                    "Tickets",
                    null,
                    new { @class = "navbar-brand" }
                )
            }


            <div class="navbar-nav">

                @if (!autenticado)
                {
                    @Html.ActionLink(
                        "Iniciar sesión",
                        "Login",
                        "Account",
                        null,
                        new { @class = "nav-link" }
                    )
                }


                @if (autenticado && rol == "Usuario")
                {
                    @Html.ActionLink(
                        "Mis tickets",
                        "MisTickets",
                        "Tickets",
                        null,
                        new { @class = "nav-link" }
                    )

                    @Html.ActionLink(
                        "Crear ticket",
                        "Crear",
                        "Tickets",
                        null,
                        new { @class = "nav-link" }
                    )
                }


                @if (autenticado && rol == "Administrador")
                {
                    @Html.ActionLink(
                        "Inicio",
                        "Inicio",
                        "Admin",
                        null,
                        new { @class = "nav-link" }
                    )

                    @Html.ActionLink(
                        "Administrar tickets",
                        "Index",
                        "Admin",
                        null,
                        new { @class = "nav-link" }
                    )

                    @Html.ActionLink(
                        "Reportes",
                        "Reporte",
                        "Admin",
                        null,
                        new { @class = "nav-link" }
                    )
                }

            </div>


            @if (autenticado)
            {
                <div class="navbar-nav ms-auto">

                    <span class="navbar-text me-3">
                        @nombre
                    </span>

                    @Html.ActionLink(
                        "Cerrar sesión",
                        "Logout",
                        "Account",
                        null,
                        new { @class = "nav-link" }
                    )

                </div>
            }

        </div>

    </nav>


    <div class="container body-content mt-4">

        @RenderBody()

        <hr />

        <footer>

            <p>
                &copy; @DateTime.Now.Year - Sistema Help Desk
            </p>

        </footer>

    </div>


    @Scripts.Render("~/bundles/jquery")

    @Scripts.Render("~/bundles/bootstrap")

    @RenderSection(
        "scripts",
        required: false
    )

</body>

</html>