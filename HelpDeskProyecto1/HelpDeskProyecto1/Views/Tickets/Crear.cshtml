@model HelpDeskProyecto1.Models.TicketCreateViewModel

@{
    ViewBag.Title = "Crear ticket";
}

<h2>Crear ticket</h2>

<p>Registre una nueva solicitud de soporte.</p>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@using (Html.BeginForm("Crear", "Tickets", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="mb-3">
        @Html.LabelFor(m => m.Titulo, new { @class = "form-label" })

        @Html.TextBoxFor(
            m => m.Titulo,
            new
            {
                @class = "form-control",
                placeholder = "Título del problema"
            }
        )

        @Html.ValidationMessageFor(
            m => m.Titulo,
            "",
            new { @class = "text-danger" }
        )
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Descripcion, new { @class = "form-label" })

        @Html.TextAreaFor(
            m => m.Descripcion,
            new
            {
                @class = "form-control",
                rows = "5",
                placeholder = "Describa el problema"
            }
        )

        @Html.ValidationMessageFor(
            m => m.Descripcion,
            "",
            new { @class = "text-danger" }
        )
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Categoria, new { @class = "form-label" })

        @Html.TextBoxFor(
            m => m.Categoria,
            new
            {
                @class = "form-control",
                placeholder = "Ejemplo: Hardware, Software, Red"
            }
        )

        @Html.ValidationMessageFor(
            m => m.Categoria,
            "",
            new { @class = "text-danger" }
        )
    </div>

    <button type="submit" class="btn btn-primary">
        Crear ticket
    </button>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}